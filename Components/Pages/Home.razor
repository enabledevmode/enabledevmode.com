@page "/"

<PageTitle>Enable Dev Mode</PageTitle>

<Section Spacing="SectionSpacing.Lg">
    <Stack Direction="new() { Base = Direction.Column, Lg = Direction.Row }" Gap="new() { Base = 10, Lg = 16 }" Align="new() { Lg = Align.Center }">
        <Column Gap="6" Grow>
            <TextBlock Family="FontFamily.Mono" Size="TextSize.Sm" Color="Color.Muted">dotnet new blazor --name YourNextApp</TextBlock>
            <Heading Level="1" Size="TextSize.Xl5" MinSize="TextSize.Xl3" Wrap="TextWrap.Balance">Build real apps with Blazor and .NET.</Heading>
            <TextBlock Size="TextSize.Lg" Color="Color.Muted" MaxWidth="Length.Rem(34)">
                Complete project builds, from the first commit to deployment. Watch the video, follow the lessons, and grab the code on GitHub.
            </TextBlock>
            <Row Gap="3" Wrap>
                <LinkButton Href="/projects" Size="ControlSize.Lg">Browse projects</LinkButton>
                <LinkButton Href="@SiteLinks.YouTube" External Size="ControlSize.Lg" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" StartIcon="Brands.YouTube">Watch on YouTube</LinkButton>
            </Row>
        </Column>
        <Box Basis="Length.Rem(22)" Shrink="false">
            <Card Title="Latest lessons" TitleLevel="2" Size="ControlSize.Sm">
                <Actions><Code>main</Code></Actions>
                <ChildContent>
                    @if (latestLessons.Count > 0)
                    {
                        <LessonLog Items="latestLessons" />
                    }
                    else
                    {
                        <TextBlock Size="TextSize.Sm" Color="Color.Muted">The first lessons are being recorded. <Anchor Href="/#newsletter">Subscribe</Anchor> to hear when they're out.</TextBlock>
                    }
                </ChildContent>
            </Card>
        </Box>
    </Stack>
</Section>

<Section Spacing="SectionSpacing.Md" PaddingTop="0">
    <Column Gap="6">
        <Row Justify="Justify.Between" Align="Align.Baseline">
            <Heading Level="2" Size="TextSize.Xl3">Projects</Heading>
            @if (projects.Count > 0)
            {
                <Anchor Href="/projects" Underline="AnchorUnderline.Hover">See all projects</Anchor>
            }
        </Row>
        @if (projects.Count > 0)
        {
            <Grid MinChildWidth="Length.Rem(18)" Gap="6">
                @foreach (var project in projects)
                {
                    <ProjectCard Project="project" />
                }
            </Grid>
        }
        else
        {
            <EmptyState Icon="Lucide.Hammer" Title="The first project is on its way" Description="Subscribe below to hear when it's out." Bordered />
        }
    </Column>
</Section>

<NewsletterBand FormName="signup-home" Source="home" />

@code {
    IReadOnlyList<CommitItem> latestLessons = [];
    IReadOnlyList<Project> projects = [];

    protected override void OnInitialized()
    {
        latestLessons = ProjectCatalog.LatestLessons(4);
        projects = ProjectCatalog.All.Take(3).ToList();
    }
}
