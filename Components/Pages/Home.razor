@page "/"
@inject RoundupArchive Archive

<PageTitle>Enable Dev Mode: The Blazor Roundup</PageTitle>
<HeadContent>
    <meta name="description" content="@Description" />
    <meta property="og:title" content="The Blazor Roundup" />
    <meta property="og:description" content="@Description" />
    <meta property="og:type" content="website" />
</HeadContent>

<Section Spacing="SectionSpacing.Lg">
    <Grid MinChildWidth="Length.Rem(25)" Gap="new() { Base = 10, Lg = 14 }" Align="Align.Center">
        <Column Gap="6">
            <Overline>The Blazor Roundup</Overline>
            <Heading Level="1" class="edm-display" Wrap="TextWrap.Balance">What's happening in Blazor, every two weeks.</Heading>
            <TextBlock Size="TextSize.Lg" Color="Color.Muted" MaxWidth="Length.Rem(34)">@Description</TextBlock>
            <Column id="newsletter" Gap="2" MaxWidth="Length.Rem(30)">
                <SignupForm FormName="signup-home" Source="home" />
                <TextBlock Size="TextSize.Sm" Color="Color.Muted">One email every two weeks. Unsubscribe anytime.</TextBlock>
            </Column>
        </Column>

        @if (Archive.Latest is { } latest)
        {
            <Panel Padding="new() { Base = 6, Md = 9 }">
                <Column Gap="5">
                    <Row Gap="3" Align="Align.Center" Wrap>
                        <Badge Accent="Accent.Primary" Variant="BadgeVariant.Solid" Pill>Latest</Badge>
                        <TextBlock As="span" Family="FontFamily.Mono" Size="TextSize.Sm" Color="Color.Muted">#@latest.Number · @IssueDates.Short(latest.Sent)</TextBlock>
                    </Row>
                    <Heading Level="2" Size="new() { Base = TextSize.Xl, Md = TextSize.Xl2 }" Wrap="TextWrap.Balance">
                        <Anchor Href="@latest.Url" Inherit Underline="AnchorUnderline.Hover">@latest.Subject</Anchor>
                    </Heading>
                    <TextBlock Color="Color.Muted">@latest.Preview</TextBlock>
                    @if (latest.Highlights.Count > 0)
                    {
                        <Column Gap="0">
                            <Divider />
                            @foreach (var highlight in latest.Highlights)
                            {
                                <TextBlock Size="TextSize.Sm" PaddingY="3">@highlight</TextBlock>
                                <Divider />
                            }
                        </Column>
                    }
                    <Box>
                        <LinkButton Href="@latest.Url" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" EndIcon="Lucide.ArrowRight">Read issue #@latest.Number</LinkButton>
                    </Box>
                </Column>
            </Panel>
        }
        else
        {
            <Panel Padding="new() { Base = 6, Md = 9 }">
                <Column Gap="3">
                    <Heading Level="2" Size="TextSize.Xl">The first issue is on its way</Heading>
                    <TextBlock Color="Color.Muted">Subscribe and it lands in your inbox. Every issue is also published here the day it sends.</TextBlock>
                </Column>
            </Panel>
        }
    </Grid>
</Section>

@if (Archive.All.Count > 0)
{
    <Section Spacing="SectionSpacing.Lg" BorderTop="1" BorderColor="Color.Border">
        <Column Gap="8">
            <Row Justify="Justify.Between" Align="Align.End" Wrap Gap="4">
                <Heading Level="2" Size="TextSize.Xl3">Latest issues</Heading>
                <Anchor Href="/roundup" Underline="AnchorUnderline.Hover" Weight="FontWeight.Semibold">All issues</Anchor>
            </Row>
            <Grid MinChildWidth="Length.Rem(18)" Gap="4">
                @foreach (var issue in Archive.All.Take(3))
                {
                    <IssueCard Issue="issue" />
                }
            </Grid>
        </Column>
    </Section>
}

<Section Spacing="SectionSpacing.Lg" BorderTop="1" BorderColor="Color.Border">
    <Column Gap="8">
        <Column Gap="2" MaxWidth="Length.Prose">
            <Heading Level="2" Size="TextSize.Xl3">What's in each issue</Heading>
            <TextBlock Color="Color.Muted">Fifteen to twenty-five items, picked from the past two weeks and checked against the source.</TextBlock>
        </Column>
        <Grid MinChildWidth="Length.Rem(12.5)" Gap="4">
            @foreach (var (name, about) in Sections)
            {
                <Card Title="@name" Variant="CardVariant.Filled" Bg="Color.SurfaceContainer" Size="ControlSize.Md">
                    <TextBlock Size="TextSize.Sm" Color="Color.Muted">@about</TextBlock>
                </Card>
            }
        </Grid>
    </Column>
</Section>

@if (ProjectCatalog.HasPublished)
{
    <Section Spacing="SectionSpacing.Lg" BorderTop="1" BorderColor="Color.Border">
        <Stack Direction="new() { Base = Direction.Column, Lg = Direction.Row }" Gap="new() { Base = 8, Lg = 12 }">
            <Column Gap="6" Grow>
                <Row Justify="Justify.Between" Align="Align.Baseline">
                    <Heading Level="2" Size="TextSize.Xl3">Projects</Heading>
                    <Anchor Href="/projects" Underline="AnchorUnderline.Hover">See all projects</Anchor>
                </Row>
                <Grid MinChildWidth="Length.Rem(18)" Gap="6">
                    @foreach (var project in ProjectCatalog.All.Take(3))
                    {
                        <ProjectCard Project="project" />
                    }
                </Grid>
            </Column>
            @if (latestLessons.Count > 0)
            {
                <Box Basis="Length.Rem(22)" Shrink="false">
                    <Card Title="Latest lessons" TitleLevel="2" Size="ControlSize.Sm">
                        <Actions><Code>main</Code></Actions>
                        <ChildContent><LessonLog Items="latestLessons" /></ChildContent>
                    </Card>
                </Box>
            }
        </Stack>
    </Section>
}

<Section Spacing="SectionSpacing.Lg" PaddingTop="0">
    <Panel>
        <Stack Direction="new() { Base = Direction.Column, Lg = Direction.Row }" Gap="new() { Base = 6, Lg = 12 }" Align="new() { Lg = Align.Center }" Justify="Justify.Between">
            <Column Gap="2" MaxWidth="Length.Prose">
                <Heading Level="2" Size="TextSize.Xl">Built in public</Heading>
                <TextBlock Color="Color.Muted">This site runs on IzzyBlazor, my component library for Blazor's static server rendering. It's in
                    alpha; each issue's house notes say what changed and what broke. Videos will land on YouTube as the projects take shape.</TextBlock>
            </Column>
            <Row Gap="3" Wrap Shrink="false">
                <LinkButton Href="@SiteLinks.IzzyBlazor" External HideExternalIcon Variant="ButtonVariant.Outline" Accent="Accent.Neutral" StartIcon="Brands.GitHub">IzzyBlazor on GitHub</LinkButton>
                <LinkButton Href="@SiteLinks.YouTube" External HideExternalIcon Variant="ButtonVariant.Outline" Accent="Accent.Neutral" StartIcon="Brands.YouTube">YouTube</LinkButton>
            </Row>
        </Stack>
    </Panel>
</Section>

@code {
    const string Description = "Releases, previews, component libraries, and the articles and discussions shaping what's next, each with a short summary and a link to the source. Free, every other Thursday.";

    // The issue's own sections, in the order they appear in it.
    static readonly (string Name, string About)[] Sections =
    [
        ("Blazor", "Framework releases, previews and security patches."),
        ("Components & libraries", "New versions, breaking changes and license shifts across the ecosystem."),
        ("Articles & videos", "Fixes and tutorials worth your time."),
        (".NET & the web", "Tooling and browser changes that touch Blazor apps."),
        ("From Enable Dev Mode", "What I'm building, including IzzyBlazor."),
    ];

    IReadOnlyList<CommitItem> latestLessons = [];

    protected override void OnInitialized() => latestLessons = ProjectCatalog.LatestLessons(4);
}
