@page "/roundup/{Number:int}"
@inject RoundupArchive Archive
@inject NavigationManager Nav

@if (issue is not null)
{
    <PageTitle>The Blazor Roundup #@issue.Number: @issue.Subject | Enable Dev Mode</PageTitle>
    <HeadContent>
        <meta name="description" content="@issue.Preview" />
        <meta property="og:title" content="@($"The Blazor Roundup #{issue.Number}: {issue.Subject}")" />
        <meta property="og:description" content="@issue.Preview" />
        <meta property="og:type" content="article" />
        <meta property="og:url" content="@Nav.ToAbsoluteUri(issue.Url)" />
        <meta property="article:published_time" content="@issue.Sent.ToString("yyyy-MM-dd")" />
    </HeadContent>

    <Section Spacing="SectionSpacing.Md">
        <Container Size="ContainerSize.Md" PaddingX="0">
            <Column Gap="8">
                <Breadcrumb Separator="BreadcrumbSeparator.Slash">
                    <BreadcrumbItem Href="/roundup">The Blazor Roundup</BreadcrumbItem>
                    <BreadcrumbItem>#@issue.Number</BreadcrumbItem>
                </Breadcrumb>

                <Column Gap="4">
                    <Overline>Issue #@issue.Number · <time datetime="@issue.Sent.ToString("yyyy-MM-dd")">@IssueDates.Long(issue.Sent)</time></Overline>
                    <Heading Level="1" Size="TextSize.Xl4" MinSize="TextSize.Xl3" Wrap="TextWrap.Balance">@issue.Subject</Heading>
                    <TextBlock Size="TextSize.Lg" Color="Color.Muted">@issue.Preview</TextBlock>
                    <Row Gap="3" Align="Align.Center" PaddingTop="2">
                        <Avatar Src="images/izzy.jpg" Name="Izzy Dryer" Size="AvatarSize.Md" Decorative />
                        <TextBlock Size="TextSize.Sm"><TextBlock As="span" Weight="FontWeight.Bold">Izzy</TextBlock> <TextBlock As="span" Color="Color.Muted">· Enable Dev Mode</TextBlock></TextBlock>
                    </Row>
                </Column>

                @* Rendered from the issue's Markdown at startup, with raw HTML turned off (RoundupArchive). *@
                <Prose Size="ProseSize.Lg" Class="edm-issue">@((MarkupString)issue.Html)</Prose>

                <nav aria-label="Issues">
                    <Grid Columns="new() { Base = 1, Sm = 2 }" Gap="4">
                        @if (previous is not null)
                        {
                            <Card Title="@($"#{previous.Number}: {previous.Subject}")" Href="@previous.Url" Size="ControlSize.Sm">
                                <Header><Overline>Previous</Overline></Header>
                            </Card>
                        }
                        else
                        {
                            <Card Title="All issues" Href="/roundup" Size="ControlSize.Sm">
                                <Header><Overline>Archive</Overline></Header>
                            </Card>
                        }
                        @if (next is not null)
                        {
                            <Card Title="@($"#{next.Number}: {next.Subject}")" Href="@next.Url" Size="ControlSize.Sm" Class="edm-next">
                                <Header><Overline>Next</Overline></Header>
                            </Card>
                        }
                        else if (Archive.NextSend is { } due)
                        {
                            <Box Padding="4" Border="1" BorderColor="Color.Border" Radius="Radius.Xl" Class="edm-dashed">
                                <Column Gap="1" Align="Align.End">
                                    <Overline>Next</Overline>
                                    <TextBlock Weight="FontWeight.Semibold">#@(issue.Number + 1) sends @due.ToString("dddd, MMM d", System.Globalization.CultureInfo.InvariantCulture)</TextBlock>
                                </Column>
                            </Box>
                        }
                        else
                        {
                            <Card Title="All issues" Href="/roundup" Size="ControlSize.Sm">
                                <Header><Overline>Archive</Overline></Header>
                            </Card>
                        }
                    </Grid>
                </nav>
            </Column>
        </Container>
    </Section>

    <NewsletterBand FormName="signup-issue" Source="@($"roundup:{issue.Number}")" Title="Get the next issue by email" />
}

@code {
    [Parameter] public int Number { get; set; }

    RoundupIssue? issue;
    RoundupIssue? previous;
    RoundupIssue? next;

    protected override void OnParametersSet()
    {
        issue = Archive.Find(Number);
        if (issue is null)
        {
            Nav.NotFound();
            return;
        }
        previous = Archive.Previous(issue);
        next = Archive.Next(issue);
    }
}
