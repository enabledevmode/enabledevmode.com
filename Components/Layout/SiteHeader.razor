@using EnableDevMode.Components.Shared
<header class="site-header">
    <div class="bar">
        <a href="/" class="brand"><Logo />Enable Dev Mode</a>
        <div class="end">
            <nav class="site-nav" aria-label="Main">
                <NavLink href="/projects">Projects</NavLink>
                <NavLink href="/about">About</NavLink>
            </nav>
            <div class="row" style="gap: var(--space-1)">
                <a class="icon-link" href="@SiteLinks.YouTube" target="_blank" rel="noopener" aria-label="YouTube"><Icon Name="youtube" /></a>
                <a class="icon-link" href="@SiteLinks.GitHub" target="_blank" rel="noopener" aria-label="GitHub"><Icon Name="github" /></a>
                <Button Href="/#newsletter" style="margin-left: var(--space-2)">Subscribe</Button>
            </div>
        </div>
    </div>
</header>