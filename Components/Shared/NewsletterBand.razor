@* The newsletter signup at the foot of a page: a filled panel with the pitch beside the form. *@
<Section Spacing="SectionSpacing.Lg">
    <Panel Id="newsletter">
        <Stack Direction="new() { Base = Direction.Column, Lg = Direction.Row }" Gap="new() { Base = 6, Lg = 12 }" Align="new() { Lg = Align.Center }">
            <Column Gap="2" Grow Basis="new() { Lg = Length.Rem(20) }">
                <Heading Level="2" Size="TextSize.Xl">@Title</Heading>
                <TextBlock Color="Color.Muted">What shipped in Blazor and .NET, every other Thursday. Unsubscribe anytime.</TextBlock>
            </Column>
            <Box Grow Basis="new() { Lg = Length.Rem(22) }">
                <SignupForm FormName="@FormName" Source="@Source" />
            </Box>
        </Stack>
    </Panel>
</Section>

@code {
    [Parameter, EditorRequired] public string FormName { get; set; } = "";
    [Parameter] public string Source { get; set; } = "site";

    /// <summary>The heading; issue pages ask for the next issue instead.</summary>
    [Parameter] public string Title { get; set; } = "Get The Blazor Roundup";
}
