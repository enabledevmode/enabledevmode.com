@inject NewsletterClient Newsletter
@inject NavigationManager Nav

@if (subscribed)
{
    <Alert Status="IzzyBlazor.Status.Success" Title="Almost done">Check your inbox to confirm your subscription.</Alert>
}
else
{
    <Form Model="Signup" FormName="@FormName" OnValidSubmit="SubmitAsync">
        @if (Label is not null)
        {
            @* Shown above the row so the button lines up with the field. The field keeps its own
               label for screen readers, so this one is hidden from them. *@
            <TextBlock Size="TextSize.Sm" Weight="FontWeight.Semibold" aria-hidden="true">@Label</TextBlock>
        }
        <Row Gap="2" Wrap Align="Align.Start">
            <Box Grow Basis="Length.Rem(14)">
                <TextField @bind-Value="Signup!.Email" HideLabel Placeholder="you@example.com" AutoComplete="email" Size="ControlSize.Lg" />
            </Box>
            <Button Type="ButtonType.Submit" Size="ControlSize.Lg">Subscribe</Button>
        </Row>
        @if (failed)
        {
            <Alert Status="IzzyBlazor.Status.Danger">Something went wrong on our end. Please try again in a minute.</Alert>
        }
    </Form>
}

@code {
    [Parameter, EditorRequired] public string FormName { get; set; } = "";
    [Parameter] public string Source { get; set; } = "site";

    /// <summary>A visible caption above the field, such as "Your email". The field's own label stays for screen readers.</summary>
    [Parameter] public string? Label { get; set; }

    [SupplyParameterFromForm] private SignupModel? Signup { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    bool subscribed;
    bool failed;

    protected override void OnInitialized() => Signup ??= new();

    async Task SubmitAsync()
    {
        var ct = HttpContext?.RequestAborted ?? CancellationToken.None;
        subscribed = await Newsletter.SubscribeAsync(Signup!.Email, Source, Nav.Uri, ct);
        failed = !subscribed;
    }

    public sealed class SignupModel
    {
        [Required(ErrorMessage = "Enter your email address.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        [Display(Name = "Email address")]
        public string Email { get; set; } = "";
    }
}
