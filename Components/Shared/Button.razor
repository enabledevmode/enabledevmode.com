@* Renders a link when Href is set, otherwise a <button>.
   Links navigate in static SSR; buttons only submit forms. *@
@if (Href is not null)
{
    <a href="@Href" class="@CssClass" target="@Target" rel="@(Target == "_blank" ? "noopener" : null)" @attributes="AdditionalAttributes">
        @if (Icon is not null) { <Icon Name="@Icon" Size="18" /> }
        @ChildContent
    </a>
}
else
{
    <button type="@Type" class="@CssClass" @attributes="AdditionalAttributes">
        @if (Icon is not null) { <Icon Name="@Icon" Size="18" /> }
        @ChildContent
    </button>
}

@code {
    [Parameter] public string? Href { get; set; }
    [Parameter] public string Kind { get; set; } = "primary";   // primary | secondary | ghost
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string Type { get; set; } = "button";    // button | submit
    [Parameter] public string? Target { get; set; }
    [Parameter] public bool Large { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    string CssClass => $"btn btn-{Kind}{(Large ? " btn-lg" : "")}";
}