@* The site's signature element: lessons shown as a commit graph. *@
<ol class="commit-log@(Detailed ? " detailed" : "")">
    @foreach (var item in Items)
    {
        <li class="@(item.Latest ? "latest" : null)">
            <div class="stack" style="gap: @(Detailed ? "var(--space-2)" : "2px")">
                <div class="row" style="align-items: baseline; gap: var(--space-1) var(--space-3)">
                    @if (Detailed)
                    {
                        <h3>@item.Title</h3>
                    }
                    else
                    {
                        <span class="label">@item.Title</span>
                    }
                    @if (item.CommitUrl is not null)
                    {
                        <a class="sha" href="@item.CommitUrl" aria-label="Commit @item.Sha">@item.Sha</a>
                    }
                </div>
                <p class="small muted">@item.Meta</p>
                @if (Detailed)
                {
                    @if (item.Description is not null)
                    {
                        <p class="prose">@item.Description</p>
                    }

                    <div class="row small" style="gap: var(--space-1) 20px; font-weight: 600">
                        @if (item.WatchUrl is not null)
                        {
                            <a href="@item.WatchUrl" class="row" style="gap: 6px">
                                <Icon Name="play" Size="14"/>
                                Watch from @item.WatchLabel</a>
                        }
                        @if (item.CommitUrl is not null)
                        {
                            <a href="@item.CommitUrl" class="row" style="gap: 6px">
                                <Icon Name="code" Size="16"/>
                                Code at this step</a>
                        }
                    </div>
                }
            </div>
        </li>
    }
</ol>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CommitItem> Items { get; set; } = [];
    [Parameter] public bool Detailed { get; set; }
}