@switch (Status)
{
    case ProjectStatus.Published:
        <Badge Status="IzzyBlazor.Status.Success" Dot>Published</Badge>
        break;
    case ProjectStatus.Coming:
        <Badge Status="IzzyBlazor.Status.Warning" Dot>Coming @ReleaseDate?.ToString("MMM d")</Badge>
        break;
    default:
        <Badge Dot>Planned</Badge>
        break;
}

@code {
    [Parameter] public ProjectStatus Status { get; set; }
    [Parameter] public DateOnly? ReleaseDate { get; set; }
}
