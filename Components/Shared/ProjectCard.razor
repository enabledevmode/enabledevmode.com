<Card Title="@Project.Title" Href="@($"/projects/{Project.Slug}")">
    <Media>
        <Image Src="@Project.Cover" Alt="" Ratio="16 / 9.0" />
    </Media>
    <ChildContent>
        <Column Gap="3">
            <Row Gap="2" Align="Align.Center">
                <StatusBadge Status="Project.Status" ReleaseDate="Project.ReleaseDate" />
                @if (Project.Lessons.Count > 0)
                {
                    <TextBlock As="span" Size="TextSize.Xs" Color="Color.Muted">@Project.Lessons.Count lessons</TextBlock>
                }
            </Row>
            <TextBlock Size="TextSize.Sm" Color="Color.Muted">@Project.Summary</TextBlock>
        </Column>
    </ChildContent>
</Card>

@code {
    [Parameter, EditorRequired] public Project Project { get; set; } = default!;
}
