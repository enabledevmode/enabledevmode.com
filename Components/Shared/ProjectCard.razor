<a href="/projects/@Project.Slug" class="project-card">
    <img class="thumb" src="@Project.Cover" alt="" loading="lazy" width="640" height="360" />
    <div class="stack" style="gap: 6px">
        <div class="row" style="gap: 10px">
            <StatusBadge Status="Project.Status" ReleaseDate="Project.ReleaseDate" />
            <span class="caption">@Project.Lessons.Count lessons</span>
        </div>
        <h3>@Project.Title</h3>
        <p class="small">@Project.Summary</p>
    </div>
</a>

@code {
    [Parameter, EditorRequired] public Project Project { get; set; } = default!;
}