@* The "E" monogram: solid stem, top and bottom bars, and a detached middle bar in the brand
   blue, like a cursor. Geometry on a 100-unit tile, from the brand guide. *@
<svg viewBox="0 0 100 100" width="@Size" height="@Size" class="logo" aria-hidden="true" focusable="false">
    <rect class="logo-tile" width="100" height="100" rx="28" />
    <rect class="logo-letter" x="28" y="24" width="12" height="52" rx="3" />
    <rect class="logo-letter" x="28" y="24" width="44" height="12" rx="3" />
    <rect class="logo-letter" x="28" y="64" width="44" height="12" rx="3" />
    <rect class="logo-cursor" x="47" y="44" width="22" height="12" rx="3" />
</svg>

@code {
    [Parameter] public int Size { get; set; } = 28;
}
