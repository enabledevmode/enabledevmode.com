<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>4f2e9272-6aee-4e4e-bbbb-5f3a7c915cff</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="IzzyBlazor" Version="0.1.0-alpha.3" />
    <PackageReference Include="Markdig" Version="1.4.0" />
  </ItemGroup>

  <!-- The Blazor Roundup's issues ship with the app and are read at startup (Data/RoundupArchive.cs). -->
  <ItemGroup>
    <None Update="Content\**\*.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
